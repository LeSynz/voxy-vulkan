{
  "schemaVersion": 1,
  "id": "voxy",
  "version": "${version}",
  "custom": {
    "commit": "${commit}",
    "buildtime": "${buildtime}"
  },
  "name": "Voxy Vulkan",
  "description": "Far distance rendering mod utilising LoDs, running on Minecraft's Vulkan backend. A Vulkan port of Voxy by MCRcortex.",
  "authors": [
    "MCRcortex (original Voxy)",
    "Synz (Vulkan port)"
  ],
  "contact": {
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/voxy/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "xyz.synz.voxyvulkan.client.VoxyClient"
    ],
    "modmenu": [
      "xyz.synz.voxyvulkan.client.config.ModMenuIntegration"
    ],
    "sodium:config_api_user": [
      "xyz.synz.voxyvulkan.client.config.VoxyConfigMenu"
    ],
    "main": [
      "xyz.synz.voxyvulkan.commonImpl.VoxyCommon"
    ]
  },
  "mixins": [
    {
      "config": "client.voxy.mixins.json",
      "environment": "client"
    },
    "common.voxy.mixins.json"
  ],
  "depends": {
    "minecraft": "${allowed_mc_version}",
    "fabricloader": ">=0.14.22",
    "fabric-api": ">=0.91.1",
    "sodium": "${allowed_sodium_versions}"
  },
  "breaks": {
    "voxyworldgenv2": "=2.2.2"
  },
  "accessWidener": "voxy.accesswidener"
}
